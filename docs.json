{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "WizzGift Docs",
  "description": "Deliver the full WizzGift gift card, premium catalog, and top-up experience inside your website or application using our secure Integration",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "favicon": "/favicon.ico",
  "ai": {
    "enabled": true
  },
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg",
    "href": "https://docs.wizzgift.com"
  },
  "contextual": {
    "options": [
      "chatgpt",
      "copy",
      "view",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "topbarCtaButton": {
    "text": "Get Started",
    "url": "/"
  },
  "navbar":{
    "tabs":[
      {
        "tab": "Documentation",
        "dropdowns": [
          {
            "dropdown": "Documentation V1.0",
            "icon": "book",
            "description": "Wizzgift Integration",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "index"
                ]
              },
              {
                "group": "Iframe Integration",
                "pages": [
                  "iframe/introduction",
                  "iframe/customization",
                  "iframe/integration"
                ]
              },
              {
                "group": "API Integration",
                "pages": [
                  "api/introduction",
                  "api/authentication",
                  "api/product",
                  "api/order"
                ]
              },
              {
                "group": "Dev Tools",
                "pages": [
                  "dev/webhook",
                  "dev/errors",
                  "dev/request-new-product"
                ]
              }
            ]
          },
          {
            "dropdown": "Changelog",
            "icon": "history",
            "description": "Updates and changes",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
