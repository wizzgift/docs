{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "WizzGift Docs",
  "description": "Deliver the full WizzGift gift card, premium catalog, and top-up experience inside your website or application using our secure Integration",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "favicon": "/favicon.ico",
  "ai": {
    "enabled": true
  },
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg",
    "href": "https://docs.wizzgift.com"
  },
  "contextual": {
    "options": [
      "chatgpt",
      "copy",
      "view",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "topbarCtaButton": {
    "text": "Get Started",
    "url": "/"
  },
    "navbar": {
    "links": [
      {
        "label": "Documentation",
        "href": "https://docs.wizzgift.com",
        "icon": "book"
      },
      {
        "label": "API Reference",
        "href": "https://docs.wizzgift.com",
        "icon": "square-terminal"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://www.wizzgift.com"
    }
  },
  "navigation": {
    "groups": [{
    "group": "API Reference",
    "openapi": "openapi.json"
  }],
    "dropdowns": [
      {
        "dropdown": "Documentation V1.0",
        "icon": "book",
        "description": "Wizzgift Integration",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Iframe Integration",
            "pages": [
              "iframe/introduction",
              "iframe/customization",
              "iframe/integration"
            ]
          },
          {
            "group": "API Integration",
            "pages": [
              "api/introduction",
              "api/authentication",
              "api/product",
              "api/order"
            ]
          },
          {
            "group": "Dev Tools",
            "pages": [
              "dev/webhook",
              "dev/errors",
              "dev/faqs",
              "dev/request-new-product"
            ]
          }
        ]
      },
      {
        "dropdown": "Changelog",
        "icon": "history",
        "description": "Updates and changes",
        "pages": [
          "changelog"
        ]
      }
    ]
  }
}